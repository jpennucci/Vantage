<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSCameraUsageDescription</key>
	<string>Vantage lets you attach a quick reference photo to a saved location.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Vantage can log your location in the background when saving a spot from the lock screen or Siri.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Vantage logs your GPS coordinates when you save a scouted location.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Vantage uses the microphone to record voice notes for a saved location.</string>
	<key>NSMotionUsageDescription</key>
	<string>Vantage checks whether you were moving when you saved a spot, to auto-tag it (e.g. Driving, On Foot).</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Vantage transcribes your voice notes into text.</string>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
